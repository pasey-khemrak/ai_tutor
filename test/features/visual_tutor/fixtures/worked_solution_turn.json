        "duration_ms": 450,
        "section_id": "step-substitute",
        "layout_zone": "working",
        "layout_flow": "vertical",
        "text": "Step 5 · Substitute into the simpler expression. The simplified expression has no problem at x = 3, so now substitution works.",
        "problem_instance_id": "problem-ad8bae3e315c4a07beec9325d03b55de",
        "active_step_id": "lesson-problem-ad8bae3e315c4a07beec9325d03b55de:step-0:ws-next-14",
        "board_version": 1,
        "base_board_version": 0,
        "action_id": "ws-step-substitute-8"
